{
  "expo": {
    "name": "SwiftScan",
    "slug": "swiftscan",
    "scheme": "swiftscan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#070b19",
    "ios": {
      "bundleIdentifier": "store.swiftscan.app",
      "buildNumber": "1",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "store.swiftscan.app",
      "adaptiveIcon": {
        "backgroundColor": "#db2777",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#070b19"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "SwiftScan uses the camera to scan barcodes and photograph products so it can estimate what they're worth.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SwiftScan lets you pick a product photo from your library to check its price.",
          "cameraPermission": "SwiftScan uses the camera to photograph products so it can estimate what they're worth."
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
