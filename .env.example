# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Monetization (all optional; features degrade gracefully when unset) ---
# Affiliate IDs (server-side; never invent these, use the ones from your own accounts)
AMAZON_ASSOCIATE_TAG=
EBAY_CAMPAIGN_ID=
# Impact-network tracking links, e.g. https://goto.walmart.com/c/123456/568844/9383
WALMART_IMPACT_LINK_PREFIX=
TARGET_IMPACT_LINK_PREFIX=
BESTBUY_IMPACT_LINK_PREFIX=

# Free scan limit per device per day (integer, or "unlimited"). Default 5.
FREE_SCANS_PER_DAY=5
# Optional: looser per-IP backstop (default 3x FREE_SCANS_PER_DAY), timezone for the daily reset
FREE_SCANS_PER_IP_PER_DAY=
QUOTA_TIMEZONE=America/Chicago
# Optional: secret used to sign the quota/pro cookies (random string)
QUOTA_COOKIE_SECRET=

# Stripe subscription (leave blank to show "Pro coming soon")
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# ---- Accounts, Pro, price alerts ----
# Database: add "Upstash for Redis" from the Vercel Marketplace (sets these automatically)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# (or UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN)
# Email (sign-in codes + price alerts): https://resend.com
# RESEND_API_KEY=
# RESEND_FROM="SwiftScan <alerts@yourdomain.com>"   # must be on a domain verified in Resend
# Random strings (e.g. `openssl rand -hex 32`)
# AUTH_SECRET=
# CRON_SECRET=
# Stripe (live): STRIPE_SECRET_KEY, STRIPE_PRICE_ID, STRIPE_WEBHOOK_SECRET
# Optional: ALERTS_MAX_FREE=3 ALERTS_MAX_PRO=25 FREE_SCANS_PER_DAY=5 APP_URL=https://www.swiftscan.store
