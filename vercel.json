{
  "cleanUrls": true,
  "rewrites": [{ "source": "/black-friday", "destination": "/" }, { "source": "/gifts", "destination": "/" }, { "source": "/deals", "destination": "/" }, { "source": "/api/(.*)", "destination": "/api" }],
  "functions": {
    "api/index.js": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/cron/check-alerts", "schedule": "0 14 * * *" },
    { "path": "/api/cron/coupon-alerts?send=1", "schedule": "0 15 * * 2" }
  ]
}
